#
# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요:  cp .env.example .env
# ⚠ .env 는 절대 커밋하지 마세요 (.gitignore 에 포함되어 있습니다). 키는 서버에만 둡니다.

# Anthropic API 키 (필수) — 서버 전용. 브라우저/리포지토리에 두지 마세요.
ANTHROPIC_API_KEY=

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# CORS 허용 오리진 (선택, 기본 *). 운영 시 프론트엔드 오리진으로 제한하세요.
# 예: CORS_ORIGIN=http://localhost:8916
CORS_ORIGIN=*

# ── 저비용(cost-efficient) 설정 (선택) ──
# 모델 — 기본은 비용 우선 claude-haiku-4-5. 품질↑ 필요 시 claude-sonnet-5 / claude-opus-5
AI_MODEL=claude-haiku-4-5
# effort — Haiku 4.5 에서는 무시됨(미지원). Sonnet/Opus 에서만 적용 (low/medium/high)
AI_EFFORT=low
# 비용 가드레일 — IP별 분당 호출 상한(기본 20)
AI_RATE_LIMIT_PER_MIN=20
# 비용 가드레일 — 월간 토큰 예산(기본 2,000,000). 초과 시 429 {fallback:true} → 프론트 목업 폴백
AI_MONTHLY_TOKEN_CAP=2000000
