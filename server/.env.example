#
# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요:  cp .env.example .env
# ⚠ .env 는 절대 커밋하지 마세요 (.gitignore 에 포함되어 있습니다). 키는 서버에만 둡니다.

# Anthropic API 키 (필수) — 서버 전용. 브라우저/리포지토리에 두지 마세요.
ANTHROPIC_API_KEY=

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# CORS 허용 오리진 (선택, 기본 *). 운영 시 프론트엔드 오리진으로 제한하세요.
# 예: CORS_ORIGIN=http://localhost:8916
CORS_ORIGIN=*
